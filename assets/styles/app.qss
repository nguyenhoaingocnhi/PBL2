QWidget {
    font-family: "Segoe UI";
    color: #1f2937;
    background: #f5f7fb;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: white;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    padding: 8px 10px;
    min-height: 32px;
}

QPushButton {
    background: #0d6efd;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background: #0b5ed7;
}

QLabel {
    color: #1f2937;
}

QMainWindow {
    background: #f3f5f9;
}

LoginWindow {
    background: #eef3f8;
}
